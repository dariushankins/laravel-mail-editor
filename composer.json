{
    "name": "dariushankins/laravel-mail-editor",
    "description": "Modern Laravel mail editor with Laravel 12/13 and PHP 8.4+ support",
    "license": "MIT",
    "authors": [
        {
            "name": "Darius Hankins",
            "email": "info@arbitragetrade.com",
            "homepage": "https://github.com/dariushankins"
        }
    ],
    "homepage": "https://github.com/dariushankins/laravel-mail-editor",
    "keywords": [
        "Laravel",
        "mailEclipse",
        "mailable-editor",
        "laravel-mail",
        "laravel-mailable",
        "mailable",
        "markdown"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dariushankins\\MailEclipse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dariushankins\\MailEclipse\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dariushankins\\MailEclipse\\MailEclipseServiceProvider"
            ],
            "aliases": {
                "MailEclipse": "Dariushankins\\MailEclipse\\Facades\\MailEclipse"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests config -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
